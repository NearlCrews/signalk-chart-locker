{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/panel/index.tsx",
    "fixtures/browser/main.tsx",
    "fixtures/browser/vite.config.mts",
    "test/*.test.ts",
    "test/*.test.mjs",
    "tests/browser/*.spec.ts",
    // Every other scripts/*.mjs is discovered through an npm script, a workflow step, or an import,
    // so listing the directory wholesale would make knip structurally unable to report an orphaned
    // script. This one is invoked as an interpolated absolute path (node "$GITHUB_WORKSPACE/..."),
    // which the workflow parser cannot resolve, so it is named here.
    "scripts/link-signalk-admin.mjs"
  ],
  // Resolved at runtime by link-signalk-admin.mjs from the Signal K host the workflow installs, not
  // from this package's own tree.
  "ignoreDependencies": [
    "signalk-server",
    "@signalk/server-admin-ui"
  ],
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "project": [
    "src/**/*.{ts,tsx}",
    "fixtures/**/*.{ts,tsx}",
    "scripts/*.mjs",
    "test/**/*.{ts,mjs}",
    "tests/**/*.ts"
  ]
}
