{
  "config": {
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false
  },
  // RUST_THIRD_PARTY_LICENSES.md is generated by cargo-about. The superpowers directory holds dated
  // design and decision memos kept as historical records, so it is out of scope for both linters;
  // cspell excludes the same prefix through ignorePaths. The publish runbook is the exception: it
  // is a maintained reference that happens to live there, so it is linted like every other one. A
  // negated ignore does not re-include a file here, so the exception is written into the patterns
  // themselves: every other memo beside it, then everything under its subdirectories.
  "ignores": [
    "RUST_THIRD_PARTY_LICENSES.md",
    "docs/superpowers/!(2026-06-30-publish-runbook).md",
    "docs/superpowers/*/**"
  ]
}
